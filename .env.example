# =====================================================================
# CGPA MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to .env and configure your values:
#
# Option A: Local SQLite Mode (Recommended for quick testing & free cloud deploy):
# Leave DB_USER, DB_PASSWORD, and DB_CONNECT_STRING empty. The server will 
# automatically create and use high-speed local SQLite database!
#
# Option B: Oracle Database Cloud (tcps / freesql.com):
# Fill in your Oracle credentials below:
# =====================================================================

PORT=3000

# Oracle Database Credentials (Optional - server falls back to SQLite if omitted)
DB_USER=your_oracle_schema_username
DB_PASSWORD=your_oracle_password
DB_CONNECT_STRING="tcps://db.freesql.com:2484/your_service_name"
